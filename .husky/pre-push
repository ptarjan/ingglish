remote="$1"
url="$2"

# Get files changed vs remote tracking branch
changed_files=$(git diff --name-only --diff-filter=ACMR "$(git merge-base HEAD "@{u}" 2>/dev/null || echo HEAD~1)")

# Only lint source files (skip config files, setup files, and generated files that eslint ignores)
ts_files=$(echo "$changed_files" | grep -E '\.(ts|tsx)$' | grep -v '\.config\.' | grep -v 'vitest\.setup\.' | grep -v '/scripts/' || true)
css_files=$(echo "$changed_files" | grep -E '\.css$' || true)

if [ -n "$ts_files" ]; then
  echo "$ts_files" | xargs npx eslint
fi

if [ -n "$css_files" ]; then
  echo "$css_files" | xargs npx stylelint
fi

# Type-check the website package (~4s) — catches 90% of CI failures
if echo "$changed_files" | grep -qE '^packages/(website|core|phonemes|ipa|normalize|dom)/'; then
  npx tsc --noEmit -p packages/website/tsconfig.json
fi

# Run tests for changed packages (1-11s each depending on package)
changed_pkgs=$(echo "$changed_files" | grep -oE '^packages/[^/]+' | sort -u | sed 's|^packages/||' || true)
if [ -n "$changed_pkgs" ]; then
  test_dirs=""
  for pkg in $changed_pkgs; do
    if [ -f "packages/$pkg/package.json" ] && grep -q '"test"' "packages/$pkg/package.json"; then
      test_dirs="$test_dirs packages/$pkg"
    fi
  done
  if [ -n "$test_dirs" ]; then
    npx vitest run --no-color $test_dirs
  fi
fi

# Docs link test (~1s) — catches broken heading anchors
if echo "$changed_files" | grep -qE '^docs/.*\.md$|^packages/website/src/components/Docs'; then
  npm run test:docs --prefix packages/website
fi
