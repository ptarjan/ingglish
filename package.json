{
  "name": "ingglish",
  "version": "1.0.0",
  "description": "Phonetic English spelling translator",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs": "typedoc && node scripts/postprocess-docs.js",
    "test": "turbo test",
    "bench": "turbo bench",
    "build": "turbo build && npm run docs",
    "build:fast": "turbo build:fast",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"**/package.json\" \"!node_modules\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"**/package.json\" \"!node_modules\"",
    "ci": "npm run build && npm run lint && npm run lint:css && npm run format:check && npm run knip && npm run test && npm run test:docs -w @ingglish/website",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "lint:css:fix": "stylelint \"packages/*/src/**/*.css\" --fix",
    "debug:roundtrip": "npm run debug:roundtrip -w ingglish --",
    "knip": "knip --cache",
    "prepare": "husky"
  },
  "keywords": [
    "phonetic",
    "english",
    "spelling",
    "pronunciation"
  ],
  "author": "Paul Tarjan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptarjan/ingglish.git"
  },
  "homepage": "https://github.com/ptarjan/ingglish#readme",
  "bugs": {
    "url": "https://github.com/ptarjan/ingglish/issues"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.18",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "husky": "^9.1.7",
    "knip": "^5.85.0",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-declaration-strict-value": "^1.11.0",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-plugin-use-baseline": "^1.4.2",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "turbo": "^2.9.14",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite-node": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "eslint-plugin-import-x": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  }
}
