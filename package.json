{
  "name": "ingglish",
  "version": "1.0.0",
  "description": "Phonetic English spelling translator",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs": "typedoc && node scripts/postprocess-docs.js",
    "test": "turbo test",
    "build": "turbo build && npm run docs",
    "build:fast": "turbo build:fast",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"**/package.json\" \"!node_modules\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"**/package.json\" \"!node_modules\"",
    "ci": "npm run build && npm run lint && npm run lint:css && npm run format:check && npm run test && npm run test:docs -w @ingglish/website",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "lint:css:fix": "stylelint \"packages/*/src/**/*.css\" --fix",
    "debug:roundtrip": "npm run debug:roundtrip -w ingglish --",
    "prepare": "husky"
  },
  "keywords": [
    "phonetic",
    "english",
    "spelling",
    "pronunciation"
  ],
  "author": "Paul Tarjan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptarjan/ingglish.git"
  },
  "homepage": "https://github.com/ptarjan/ingglish#readme",
  "bugs": {
    "url": "https://github.com/ptarjan/ingglish/issues"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0",
    "tsup": "^8.5.1",
    "turbo": "^2.8.10",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
