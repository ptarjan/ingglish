{
  "name": "@ingglish/dom",
  "version": "1.0.0",
  "description": "DOM translation utilities for Ingglish",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint src",
    "test": "vitest run --no-color",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ingglish/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^27.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "dom",
    "translation",
    "phonetic",
    "english"
  ],
  "license": "MIT"
}
