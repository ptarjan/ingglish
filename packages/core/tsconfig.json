{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@ingglish/normalize": ["../normalize/src/index.ts"],
      "@ingglish/phonemes": ["../phonemes/src/index.ts"],
      "@ingglish/tokenize": ["../tokenize/src/index.ts"],
      "@ingglish/dictionary": ["../dictionary/src/index.ts"],
      "@ingglish/fallback": ["../fallback/src/index.ts"],
      "@ingglish/g2p": ["../g2p/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
