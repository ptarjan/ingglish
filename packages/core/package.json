{
  "name": "@ingglish/core",
  "version": "1.0.0",
  "description": "Core phonetic English translation library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./internal": {
      "source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run update-dictionaries",
    "build": "tsup src/index.ts src/internal.ts --format cjs,esm --dts",
    "build:fast": "npm run update-dictionaries && tsup src/index.ts src/internal.ts --format esm",
    "lint": "eslint --cache src",
    "pretest": "npm run update-dictionaries",
    "test": "vitest run --no-color",
    "test:watch": "npm run update-dictionaries && vitest",
    "translate": "npx vite-node scripts/translate.ts",
    "debug:roundtrip": "npx vite-node scripts/debug-roundtrip.ts",
    "analyze-collisions": "npx vite-node scripts/collision-analysis.ts",
    "update-dictionaries": "node scripts/ensure-dictionaries.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "phonemize": "^1.1.0",
    "subtlex-word-frequencies": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^28.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "phonetic",
    "english",
    "pronunciation",
    "spelling",
    "ipa",
    "cmu",
    "dictionary"
  ],
  "author": "Paul Tarjan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptarjan/ingglish.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ptarjan/ingglish#readme",
  "bugs": {
    "url": "https://github.com/ptarjan/ingglish/issues"
  }
}
