{
  "name": "@ingglish/website",
  "version": "1.0.0",
  "description": "Ingglish website — tutorial, text/URL translator, spelling guide, and docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsc --noEmit",
    "build": "vite build",
    "build:fast": "vite build",
    "lint": "eslint --cache src",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --no-color",
    "test:docs": "vitest run src/components/Docs.test.ts --config vitest.docs.config.ts --no-color",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "ingglish": "^1.0.0",
    "@ingglish/dom": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.16",
    "marked": "^17.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
