{
  "name": "@ingglish/website",
  "version": "1.0.0",
  "description": "Ingglish website — tutorial, text/URL translator, spelling guide, and docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-ipa-dicts.cjs && tsc --noEmit",
    "build": "vite build",
    "build:fast": "node scripts/ensure-ipa-dicts.cjs && vite build",
    "lint": "eslint --cache src",
    "preview": "vite preview",
    "pretest": "node scripts/ensure-ipa-dicts.cjs",
    "test": "vitest run --no-color",
    "test:docs": "vitest run src/components/Docs.test.ts --no-color",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ingglish/deseret": "^1.0.0",
    "@ingglish/dictionary": "^1.0.0",
    "@ingglish/dom": "^1.0.0",
    "@ingglish/fallback": "^1.0.0",
    "@ingglish/g2p": "^1.0.0",
    "@ingglish/ipa": "^1.0.0",
    "@ingglish/phonemes": "^1.0.0",
    "@ingglish/normalize": "^1.0.0",
    "@ingglish/shavian": "^1.0.0",
    "dompurify": "^3.3.1",
    "ingglish": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "marked": "^17.0.3",
    "vite": "^7.3.1"
  }
}
