{
  "name": "@ingglish/extension",
  "version": "1.0.0",
  "description": "Browser extension to translate any webpage to phonetic Ingglish",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup",
    "postbuild": "node scripts/copy-assets.js && node scripts/generate-icons.js",
    "build:icons": "node scripts/generate-icons.js",
    "test": "vitest run --no-color",
    "lint": "eslint --cache src",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "ingglish": "^1.0.0",
    "@ingglish/dom": "^1.0.0",
    "@ingglish/normalize": "^1.0.0",
    "@ingglish/phonemes": "^1.0.0",
    "@ingglish/ipa": "^1.0.0",
    "@ingglish/shavian": "^1.0.0",
    "@ingglish/deseret": "^1.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "jsdom": "^28.1.0",
    "sharp": "^0.34.5"
  }
}
