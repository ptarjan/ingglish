{
  "name": "@ingglish/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/content.ts src/background.ts src/popup.ts --format iife --outDir dist --clean && node scripts/copy-assets.js && node scripts/generate-icons.js",
    "build:icons": "node scripts/generate-icons.js",
    "lint": "eslint src",
    "watch": "npm run build -- --watch",
    "test": "vitest run --no-color src/background.test.ts src/content.test.ts"
  },
  "dependencies": {
    "@ingglish/core": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^27.4.0",
    "sharp": "^0.34.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}
