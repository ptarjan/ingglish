{
  "name": "@ingglish/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/content-lite.ts src/background.ts src/popup.ts --format iife --outDir dist --clean",
    "postbuild": "node scripts/copy-assets.js && node scripts/generate-icons.js",
    "build:icons": "node scripts/generate-icons.js",
    "lint": "eslint --cache src",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "@ingglish/core": "^1.0.0",
    "@ingglish/dom": "^1.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "sharp": "^0.34.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
