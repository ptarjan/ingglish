{
  "name": "@ingglish/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/content.ts src/background.ts src/popup.ts --format iife --outDir dist --clean && cp src/manifest.json src/popup.html src/popup.css dist/ && node scripts/generate-icons.js",
    "build:icons": "node scripts/generate-icons.js",
    "watch": "npm run build -- --watch",
    "test": "vitest run --no-color"
  },
  "dependencies": {
    "@ingglish/core": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "jsdom": "^27.4.0",
    "sharp": "^0.34.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}
