{
  "manifest_version": 3,
  "name": "Ingglish - Phonetic English",
  "version": "1.0.0",
  "description": "Translate any webpage to phonetic English spelling. Words are spelled exactly as they sound!",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ingglish Translator",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "48": "icons/icon48-off.png",
      "128": "icons/icon128-off.png"
    }
  },
  "background": {
    "service_worker": "background.global.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.global.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
