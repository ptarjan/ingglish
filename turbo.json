{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:fast": {
      "dependsOn": ["^build:fast"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["src/**", "tsconfig*.json"]
    },
    "test": {
      "inputs": ["src/**", "tsconfig*.json", "vitest.config.*", "vitest.setup.*"]
    },
    "bench": {
      "cache": false,
      "inputs": ["src/**", "tsconfig*.json", "vitest.config.*", "vitest.setup.*"]
    }
  }
}
