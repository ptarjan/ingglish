{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:fast": {
      "dependsOn": ["^build:fast"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["src/**", "eslint.config.*", "tsconfig*.json"]
    },
    "test": {
      "inputs": ["src/**", "tsconfig*.json"]
    }
  }
}
