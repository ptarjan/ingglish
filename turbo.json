{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@ingglish/cors-proxy#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ingglish/website#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@ingglish/website#build:fast": {
      "dependsOn": ["^build:fast"],
      "inputs": ["src/**"],
      "cache": false
    },
    "build:fast": {
      "dependsOn": ["^build:fast"],
      "inputs": ["src/**"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["src/**", "tsconfig*.json"]
    },
    "test": {
      "inputs": ["src/**", "scripts/**", "tsconfig*.json", "vitest.config.*", "vitest.setup.*"]
    },
    "test:cli": {
      "inputs": ["scripts/**", "src/**", "tsconfig*.json", "vitest.config.*", "vitest.setup.*"]
    },
    "test:dict-coverage": {
      "inputs": ["src/**", "tsconfig*.json", "vitest.config.*"]
    },
    "bench": {
      "cache": false,
      "inputs": ["src/**", "tsconfig*.json", "vitest.config.*", "vitest.setup.*"]
    },
    "//#knip": {
      "inputs": [
        "packages/*/src/**",
        "packages/*/package.json",
        "package.json",
        "knip.config.ts",
        "tsconfig.base.json"
      ],
      "outputs": []
    }
  }
}
